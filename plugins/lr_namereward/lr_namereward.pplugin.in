{
	"$schema": "https://raw.githubusercontent.com/untrustedmodders/plugify/refs/heads/main/schemas/plugin.schema.json",
	"version": "${LR_NAMEREWARD_VERSION}",
	"name": "lr_namereward",
	"description": "[LR] Name Reward: multiplies the experience of a kill when the attacker's name contains the configured substring (configs/levels_ranks/namereward.ini: 'multi' and 'name'). Ported from the Pisex Levels Ranks module LR_NameReward. Requires the levels_ranks core; no exported methods.",
	"author": "Pisex, ported to Plugify",
	"website": "https://github.com/untrustedmodders/plugify",
	"license": "GPL-3.0",
	"entry": "bin/lr_namereward",
	"platforms": [],
	"language": "cpp",
	"dependencies": [
		{
			"name": "s2sdk",
			"constraints": ">=2.18.2"
		},
		{
			"name": "levels_ranks",
			"constraints": ">=1.0.0"
		},
		{
			"name": "hudmenu",
			"constraints": ">=1.0.0",
			"optional": true
		}
	],
	"methods": []
}
